# couple-daily API. Copy to backend/.env. Do not commit .env.

HTTP_ADDR=:8080

DATABASE_URL=postgres://couple:couple@localhost:5432/couple_daily?sslmode=disable
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=couple-daily
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_USE_PATH_STYLE=true

JWT_SECRET=change-me
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=720h

# iOS push (APNs). Leave empty until credentials exist.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=

# Android push (FCM). Leave empty until credentials exist.
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
