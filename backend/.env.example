# couple-daily API. Copy to backend/.env. Do not commit .env.
#
# APP_ENV=local or dev is the only setting that may use the example JWT_SECRET
# and MinIO keys below. Leave APP_ENV unset, or set it to anything else, and the
# process refuses to start until JWT_SECRET is a random value of at least 32
# characters and the S3 key/secret are not the MinIO example.

APP_ENV=local

HTTP_ADDR=:8080

DATABASE_URL=postgres://couple:couple@localhost:5432/couple_daily?sslmode=disable
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=couple-daily
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_USE_PATH_STYLE=true

# Example only. Allowed solely because APP_ENV=local. Use at least 32 random characters elsewhere.
JWT_SECRET=change-me
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=720h

# iOS push (APNs). Leave empty to stub delivery; POST /devices still registers tokens.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=
# Debug builds use the sandbox gateway. Ignored when the key fields above are empty.
APNS_USE_SANDBOX=false

# Android push (FCM HTTP v1). Leave empty to stub delivery; token registration still works.
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
